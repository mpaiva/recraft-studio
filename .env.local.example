# Recraft's API is billed from a PREPAID balance that is separate from the
# subscription credits the web editor spends. A topped-up plan can sit beside a
# zero here, and the only symptom is a 400 on the first image. Check /api/balance.
RECRAFT_API_TOKEN=your_token_here

# Optional. A custom style trained on reference images, created with
# `npm run style -- ref1.png ref2.png`. Without one the app falls back to the
# built-in colored_stencil substyle, which is a reasonable floor but will not
# hold a set together the way a trained style does.
RECRAFT_STYLE_ID=

# Optional. Used only by "Improve subjects", which asks Claude to rewrite the
# subject lines for the chosen industry. Billed by Anthropic, not Recraft.
# Drawing works without it.
ANTHROPIC_API_KEY=
